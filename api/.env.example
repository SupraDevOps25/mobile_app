# ─── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Public base URL of THIS API (used in emails/links). In dev this is your LAN
# URL or an ngrok tunnel, e.g. http://192.168.0.114:3000
API_URL="http://localhost:3000"

# Scheduled jobs (offer escalation, missed-visit flagging, notification purge).
# OFF unless "true" — they poll the DB and would keep a scale-to-zero database
# (Neon) awake 24/7. Enable in production at launch, not before.
CRONS_ENABLED=false

# ─── Database ───────────────────────────────────────────────────────────────
# Local dev: Docker Postgres (see repo-root docker-compose.yml):
#   postgresql://supracarer:supracarer@localhost:5432/supracarer
# Production: Neon (set on Railway). Format:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://supracarer:supracarer@localhost:5432/supracarer"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Long random string. Generate one: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# ─── Paystack (payments) ────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
# DEV: use the TEST secret key (starts with sk_test_...).
# PROD: swap in the LIVE secret key (starts with sk_live_...). Never commit it.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional. Where Paystack redirects after the hosted checkout. The app also
# verifies server-side on return, so this is mostly cosmetic in dev.
PAYSTACK_CALLBACK_URL=""
# Optional. Defaults to PAYSTACK_SECRET_KEY (Paystack signs webhooks with it).
# Only set this if you configure a separate webhook signing secret.
PAYSTACK_WEBHOOK_SECRET=""

# ─── Email (Resend preferred, SMTP fallback, optional in dev) ───────────────
# Preferred: set RESEND_API_KEY and MAIL_FROM after verifying your sending
# domain in Resend. If RESEND_API_KEY is unset, SMTP is used. If both are unset,
# emails are logged to the console instead of sent.
RESEND_API_KEY=""
MAIL_FROM="Supracarer <no-reply@supracarer.app>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Supracarer <no-reply@supracarer.app>"
# Where family "no package fits" custom-care requests are emailed. Falls back to
# SUPPORT_EMAIL, then support@supracarer.app. Set this to your real admin inbox.
ADMIN_EMAIL=""
SUPPORT_EMAIL=""

# ─── WhatsApp / SMS (Twilio, optional) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# ─── Cloudinary (file uploads: caregiver photo + credentials) ───────────────
# Get these from https://console.cloudinary.com (Dashboard → Product Environment).
# If unset, uploads return a clear 400 instead of crashing the server.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
