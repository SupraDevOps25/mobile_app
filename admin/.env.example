# Base URL of the Supracarer API (NestJS), including the /api/v1 prefix.
# Copy this file to .env.local and adjust. For production, set this in the host's
# environment variables (Vercel/etc.) rather than committing the live URL.
#
#   Local API:  http://localhost:3000/api/v1
#   Production: https://<your-api-host>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
